# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for canonical links, sitemap.xml, and API endpoints.
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT="3000"

# NODE_ENV: Environment mode (development | production | test)
NODE_ENV="development"

# VITE_BASE_PATH: Public base path for Vite build ('/' for root domain / Vercel / Express, '/RAVAQ/' for GitHub Pages)
VITE_BASE_PATH="/"

# DEMO_ADMIN_PASSWORD (optional override for local demo admin)
DEMO_ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"
