rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // 1. GLOBAL SAFETY NET (Default-Deny)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. CORE PRIMITIVES & ZERO-TRUST ADMIN GUARD
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strictly restricts Admin access to the verified project owner email
    // (fawti.tiri2@gmail.com) or an explicit document in /admins/{uid}.
    // Client headers, localStorage, or unverified emails are NEVER trusted.
    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'fawti.tiri2@gmail.com'
      );
    }

    // =========================================================================
    // 3. ENTITY VALIDATION BLUEPRINTS
    // =========================================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role is string && data.role.size() <= 20 && (data.role == 'CUSTOMER' || data.role == 'ADMIN') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'mobile', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('mobile' in data.keys()) || (data.mobile is string && data.mobile.size() == 11 && data.mobile.matches('^09[0-9]{9}$'))) &&
        data.updatedAt is timestamp;
    }

    function isValidCustomerAddress(data) {
      return data.keys().hasAll(['uid', 'recipientName', 'mobile', 'province', 'city', 'addressLine', 'postalCode', 'isDefault', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'recipientName', 'mobile', 'province', 'city', 'addressLine', 'postalCode', 'isDefault', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.recipientName is string && data.recipientName.size() >= 2 && data.recipientName.size() <= 100 &&
        data.mobile is string && data.mobile.size() == 11 && data.mobile.matches('^09[0-9]{9}$') &&
        data.province is string && data.province.size() >= 2 && data.province.size() <= 60 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 60 &&
        data.addressLine is string && data.addressLine.size() >= 5 && data.addressLine.size() <= 300 &&
        data.postalCode is string && data.postalCode.size() == 10 && data.postalCode.matches('^[0-9]{10}$') &&
        data.isDefault is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategoryRecord(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'shortDescription', 'description', 'displayOrder', 'active', 'illustrationKey']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'shortDescription', 'description', 'displayOrder', 'active', 'illustrationKey']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 80 && data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.shortDescription is string && data.shortDescription.size() <= 300 &&
        data.description is string && data.description.size() <= 1000 &&
        data.displayOrder is int && data.displayOrder >= 0 &&
        data.active is bool &&
        data.illustrationKey is string && data.illustrationKey.size() >= 1 && data.illustrationKey.size() <= 60;
    }

    function isValidProductRecord(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'categorySlug', 'categoryName', 'shortDescription', 'fullDescription', 'basePrice', 'published', 'featured', 'sku', 'variants', 'images', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'categorySlug', 'categoryName', 'shortDescription', 'fullDescription', 'basePrice', 'published', 'featured', 'sku', 'variants', 'images', 'bundleItems', 'packagingDetails', 'occasionTags', 'ingredientsOrMaterial', 'allergens', 'storageOrCare', 'dimensionsOrWeight', 'origin', 'fragileWarning', 'seoTitle', 'seoDescription', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 120 && data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.categorySlug is string && data.categorySlug.size() >= 2 && data.categorySlug.size() <= 80 &&
        data.categoryName is string && data.categoryName.size() >= 2 && data.categoryName.size() <= 120 &&
        data.shortDescription is string && data.shortDescription.size() <= 400 &&
        data.fullDescription is string && data.fullDescription.size() <= 2000 &&
        data.basePrice is int && data.basePrice >= 0 &&
        data.published is bool &&
        data.featured is bool &&
        data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 60 &&
        data.variants is list && data.variants.size() >= 1 && data.variants.size() <= 20 &&
        data.variants[0] is map &&
        data.images is list && data.images.size() >= 1 && data.images.size() <= 10 &&
        data.images[0] is map &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidCouponRecord(data) {
      return data.keys().hasAll(['id', 'code', 'description', 'discountType', 'discountValue', 'minOrderAmount', 'startsAt', 'endsAt', 'active', 'usageLimit', 'usedCount', 'perCustomerLimit']) &&
        data.keys().hasOnly(['id', 'code', 'description', 'discountType', 'discountValue', 'minOrderAmount', 'maxDiscountAmount', 'categorySlugRestriction', 'startsAt', 'endsAt', 'active', 'usageLimit', 'usedCount', 'perCustomerLimit']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 40 &&
        data.description is string && data.description.size() <= 300 &&
        data.discountType is string && data.discountType.size() <= 20 && (data.discountType == 'PERCENTAGE' || data.discountType == 'FIXED') &&
        data.discountValue is int && data.discountValue >= 1 &&
        data.minOrderAmount is int && data.minOrderAmount >= 0 &&
        data.startsAt is string && data.startsAt.size() <= 40 &&
        data.endsAt is string && data.endsAt.size() <= 40 &&
        data.active is bool &&
        data.usageLimit is int && data.usageLimit >= 1 &&
        data.usedCount is int && data.usedCount >= 0 && data.usedCount <= data.usageLimit &&
        data.perCustomerLimit is int && data.perCustomerLimit >= 1;
    }

    function isValidCouponRedemption(data) {
      return data.keys().hasAll(['id', 'couponId', 'couponCode', 'orderId', 'userId', 'customerMobile', 'discountAmount', 'redeemedAt']) &&
        data.keys().hasOnly(['id', 'couponId', 'couponCode', 'orderId', 'userId', 'customerMobile', 'discountAmount', 'redeemedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 100 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.couponId is string && data.couponId.size() >= 1 && data.couponId.size() <= 80 &&
        data.couponCode is string && data.couponCode.size() >= 2 && data.couponCode.size() <= 40 &&
        data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 80 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.customerMobile is string && data.customerMobile.size() == 11 && data.customerMobile.matches('^09[0-9]{9}$') &&
        data.discountAmount is int && data.discountAmount >= 0 &&
        data.redeemedAt is string && data.redeemedAt.size() <= 40;
    }

    function isValidOrderRecord(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'userId', 'customerName', 'customerMobile', 'province', 'city', 'addressLine', 'postalCode', 'deliveryMethod', 'items', 'subtotal', 'discountAmount', 'shippingCost', 'totalAmount', 'status', 'paymentStatus', 'stockDeducted', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'orderNumber', 'userId', 'customerName', 'customerMobile', 'customerEmail', 'province', 'city', 'addressLine', 'postalCode', 'orderNote', 'deliveryMethod', 'items', 'subtotal', 'discountAmount', 'couponCode', 'shippingCost', 'totalAmount', 'status', 'paymentStatus', 'stockDeducted', 'idempotencyKey', 'isSimulatedDemo', 'lastAttemptRef', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerMobile is string && data.customerMobile.size() == 11 && data.customerMobile.matches('^09[0-9]{9}$') &&
        data.province is string && data.province.size() >= 2 && data.province.size() <= 60 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 60 &&
        data.addressLine is string && data.addressLine.size() >= 5 && data.addressLine.size() <= 300 &&
        data.postalCode is string && data.postalCode.size() == 10 && data.postalCode.matches('^[0-9]{10}$') &&
        data.deliveryMethod is string && data.deliveryMethod.size() <= 30 && (data.deliveryMethod == 'STANDARD' || data.deliveryMethod == 'EXPRESS_TEHRAN') &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map &&
        data.subtotal is int && data.subtotal >= 0 &&
        data.discountAmount is int && data.discountAmount >= 0 &&
        data.shippingCost is int && data.shippingCost >= 0 &&
        data.totalAmount is int && data.totalAmount >= 0 &&
        data.status is string && data.status.size() <= 30 &&
        (data.status == 'PENDING_PAYMENT' || data.status == 'PAID' || data.status == 'PROCESSING' || data.status == 'SHIPPED' || data.status == 'DELIVERED' || data.status == 'CANCELLED') &&
        data.paymentStatus is string && data.paymentStatus.size() <= 30 &&
        (data.paymentStatus == 'PENDING' || data.paymentStatus == 'SUCCEEDED' || data.paymentStatus == 'FAILED' || data.paymentStatus == 'CANCELLED' || data.paymentStatus == 'EXPIRED') &&
        data.stockDeducted is bool &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidPaymentAttempt(data) {
      return data.keys().hasAll(['id', 'attemptRef', 'orderId', 'orderNumber', 'userId', 'amount', 'status', 'createdAt', 'updatedAt', 'expiresAt']) &&
        data.keys().hasOnly(['id', 'attemptRef', 'orderId', 'orderNumber', 'userId', 'amount', 'status', 'failureReason', 'isSimulatedDemo', 'createdAt', 'updatedAt', 'expiresAt', 'completedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.attemptRef is string && data.attemptRef.size() >= 4 && data.attemptRef.size() <= 80 && data.attemptRef.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 80 && data.orderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.amount is int && data.amount >= 0 &&
        data.status is string && data.status.size() <= 30 &&
        (data.status == 'PENDING' || data.status == 'SUCCEEDED' || data.status == 'FAILED' || data.status == 'CANCELLED' || data.status == 'EXPIRED') &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40 &&
        data.expiresAt is string && data.expiresAt.size() <= 40;
    }

    function isValidOrderStatusHistory(data) {
      return data.keys().hasAll(['id', 'orderId', 'userId', 'status', 'paymentStatus', 'note', 'actor', 'createdAt']) &&
        data.keys().hasOnly(['id', 'orderId', 'userId', 'status', 'paymentStatus', 'note', 'actor', 'createdAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 100 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 80 && data.orderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.status is string && data.status.size() <= 30 &&
        data.paymentStatus is string && data.paymentStatus.size() <= 30 &&
        data.note is string && data.note.size() >= 1 && data.note.size() <= 500 &&
        data.actor is string && data.actor.size() >= 1 && data.actor.size() <= 160 &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidOrderTrackingSummary(data) {
      return data.keys().hasAll(['trackingKey', 'orderNumber', 'status', 'paymentStatus', 'createdAt', 'updatedAt', 'city', 'province', 'maskedRecipient', 'maskedMobile', 'totalAmount', 'items', 'history']) &&
        data.keys().hasOnly(['trackingKey', 'orderNumber', 'userId', 'status', 'paymentStatus', 'createdAt', 'updatedAt', 'city', 'province', 'maskedRecipient', 'maskedMobile', 'totalAmount', 'items', 'history']) &&
        data.trackingKey is string && data.trackingKey.size() >= 6 && data.trackingKey.size() <= 80 && data.trackingKey.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 &&
        data.status is string && data.status.size() <= 30 &&
        data.paymentStatus is string && data.paymentStatus.size() <= 30 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40 &&
        data.city is string && data.city.size() <= 60 &&
        data.province is string && data.province.size() <= 60 &&
        data.maskedRecipient is string && data.maskedRecipient.size() <= 80 &&
        data.maskedMobile is string && data.maskedMobile.size() <= 20 &&
        data.totalAmount is int && data.totalAmount >= 0 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map &&
        data.history is list && data.history.size() >= 1 && data.history.size() <= 50 && data.history[0] is map;
    }

    function isValidInventoryMovement(data) {
      return data.keys().hasAll(['id', 'productId', 'productName', 'variantId', 'variantLabel', 'sku', 'delta', 'previousStock', 'newStock', 'reason', 'referenceId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'productId', 'productName', 'variantId', 'variantLabel', 'sku', 'delta', 'previousStock', 'newStock', 'reason', 'referenceId', 'createdAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 100 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 80 &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160 &&
        data.variantId is string && data.variantId.size() >= 1 && data.variantId.size() <= 80 &&
        data.variantLabel is string && data.variantLabel.size() >= 1 && data.variantLabel.size() <= 120 &&
        data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 60 &&
        data.delta is int &&
        data.previousStock is int && data.previousStock >= 0 &&
        data.newStock is int && data.newStock >= 0 &&
        data.reason is string && data.reason.size() <= 40 &&
        (data.reason == 'ORDER_PAID' || data.reason == 'BUNDLE_COMPONENT_PAID' || data.reason == 'ADMIN_ADJUSTMENT' || data.reason == 'INITIAL_SEED') &&
        data.referenceId is string && data.referenceId.size() >= 1 && data.referenceId.size() <= 160 &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidProductReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'authorName', 'rating', 'comment', 'createdAt']) &&
        data.keys().hasOnly(['id', 'productId', 'productSlug', 'userId', 'authorName', 'rating', 'comment', 'createdAt']) &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 80 && data.productId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 600 &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidNewsletterSubscription(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'createdAt']) &&
        data.id is string && data.id.size() >= 3 && data.id.size() <= 120 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll(['storeName', 'storeTagline', 'supportEmail', 'supportHours', 'freeShippingThreshold', 'standardShippingCost', 'expressTehranShippingCost', 'minOrderAmount', 'demoModeNotice']) &&
        data.keys().hasOnly(['storeName', 'storeTagline', 'supportEmail', 'supportHours', 'freeShippingThreshold', 'standardShippingCost', 'expressTehranShippingCost', 'minOrderAmount', 'demoModeNotice', 'instagramUrl', 'telegramUrl']) &&
        data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 120 &&
        data.storeTagline is string && data.storeTagline.size() <= 240 &&
        data.supportEmail is string && data.supportEmail.size() <= 160 &&
        data.supportHours is string && data.supportHours.size() <= 160 &&
        data.freeShippingThreshold is int && data.freeShippingThreshold >= 0 &&
        data.standardShippingCost is int && data.standardShippingCost >= 0 &&
        data.expressTehranShippingCost is int && data.expressTehranShippingCost >= 0 &&
        data.minOrderAmount is int && data.minOrderAmount >= 0 &&
        data.demoModeNotice is string && data.demoModeNotice.size() <= 500;
    }

    // =========================================================================
    // 4. COLLECTION MATCH BLOCKS
    // =========================================================================

    // Admins lookup collection (Immutable from client)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }

    // Users collection (Public/Basic profile; Role escalation strictly blocked)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role == 'CUSTOMER' || isAdmin());
      allow update: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);

      // Isolated PII Subcollection
      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && (
          isAdmin() ||
          (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid)
        );
        allow list: if false;
        allow create: if isVerified() && isValidId(userId) && isValidId(docId) && isOwner(userId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isVerified() && isValidId(userId) && isValidId(docId) && isValidUserPrivateInfo(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isOwner(userId) &&
              get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['email', 'mobile', 'updatedAt']))
          );
        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }

      // Saved Iranian Addresses Subcollection
      match /addresses/{addressId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(addressId) && (
          isAdmin() ||
          (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid)
        );
        allow list: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource.data.uid == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(addressId) && isOwner(userId) &&
          isValidCustomerAddress(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isVerified() && isValidId(userId) && isValidId(addressId) && isValidCustomerAddress(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isOwner(userId) &&
              get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['recipientName', 'mobile', 'province', 'city', 'addressLine', 'postalCode', 'isDefault', 'updatedAt']))
          );
        allow delete: if isVerified() && isValidId(userId) && isValidId(addressId) && (
          isAdmin() ||
          (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid)
        );
      }
    }

    function isSameVariantCore(newVar, oldVar) {
      return newVar.id == oldVar.id &&
        newVar.sku == oldVar.sku &&
        newVar.label == oldVar.label &&
        newVar.price == oldVar.price &&
        newVar.stock is int &&
        newVar.stock >= 0 &&
        newVar.stock <= oldVar.stock;
    }

    function isValidCustomerStockDeduction(newVars, oldVars) {
      return newVars.size() == oldVars.size() &&
        isSameVariantCore(newVars[0], oldVars[0]) &&
        (oldVars.size() < 2 || isSameVariantCore(newVars[1], oldVars[1])) &&
        (oldVars.size() < 3 || isSameVariantCore(newVars[2], oldVars[2]));
    }

    // Categories Collection (Public read; Admin write)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(categoryId) && isValidCategoryRecord(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // Products Collection (Public read; Admin CRUD; Verified Customer non-increasing stock deduction only with immutable variant prices/SKUs)
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidId(productId) && isValidProductRecord(incoming());
      allow update: if isValidId(productId) && isValidProductRecord(incoming()) && (
        isAdmin() ||
        (isVerified() &&
          incoming().id == existing().id &&
          incoming().slug == existing().slug &&
          incoming().name == existing().name &&
          incoming().basePrice == existing().basePrice &&
          incoming().published == existing().published &&
          incoming().diff(existing()).affectedKeys().hasOnly(['variants', 'updatedAt']) &&
          isValidCustomerStockDeduction(incoming().variants, existing().variants))
      );
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Coupons Collection (Public read; Admin CRUD; Verified Customer atomic usedCount increment)
    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin() && isValidId(couponId) && isValidCouponRecord(incoming());
      allow update: if isValidId(couponId) && isValidCouponRecord(incoming()) && (
        isAdmin() ||
        (isVerified() &&
          incoming().id == existing().id &&
          incoming().code == existing().code &&
          incoming().discountType == existing().discountType &&
          incoming().discountValue == existing().discountValue &&
          incoming().usedCount == existing().usedCount + 1 &&
          incoming().diff(existing()).affectedKeys().hasOnly(['usedCount']))
      );
      allow delete: if isAdmin() && isValidId(couponId);
    }

    // Coupon Redemptions Collection (Tied to caller's own PAID order)
    match /couponRedemptions/{redemptionId} {
      allow get: if isSignedIn() && isValidId(redemptionId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(redemptionId) &&
        isValidCouponRedemption(incoming()) &&
        incoming().userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/orders/$(incoming().orderId)).data.status == 'PAID';
      allow update, delete: if false;
    }

    // Store Settings Collection
    match /settings/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;
      allow create, update: if isAdmin() && isValidId(docId) && isValidStoreSettings(incoming());
      allow delete: if false;
    }

    // Orders Collection (Owner & Admin isolated; simulated demo payment transitions guarded)
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(orderId) &&
        isValidOrderRecord(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'PENDING_PAYMENT' &&
        incoming().paymentStatus == 'PENDING' &&
        incoming().stockDeducted == false &&
        incoming().isSimulatedDemo == true;
      allow update: if isVerified() && isValidId(orderId) && isValidOrderRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().userId == existing().userId &&
        incoming().totalAmount == existing().totalAmount &&
        incoming().subtotal == existing().subtotal &&
        incoming().discountAmount == existing().discountAmount &&
        incoming().shippingCost == existing().shippingCost &&
        incoming().createdAt == existing().createdAt && (
          // Tier 1: Admin fulfillment status update (cannot mark unpaid order as PAID/SHIPPED)
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            (incoming().status == 'CANCELLED' || existing().paymentStatus == 'SUCCEEDED')) ||
          // Tier 2: Owner simulated demo payment transition on PENDING_PAYMENT order
          (existing().userId == request.auth.uid &&
            existing().status == 'PENDING_PAYMENT' &&
            existing().stockDeducted == false &&
            incoming().isSimulatedDemo == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'stockDeducted', 'lastAttemptRef', 'updatedAt']) && (
              // Action A: Simulated Demo Payment SUCCEEDED (requires matching PaymentAttempt in same transaction)
              (incoming().status == 'PAID' &&
                incoming().paymentStatus == 'SUCCEEDED' &&
                incoming().stockDeducted == true &&
                incoming().lastAttemptRef is string &&
                getAfter(/databases/$(database)/documents/paymentAttempts/$(incoming().lastAttemptRef)).data.orderId == orderId &&
                getAfter(/databases/$(database)/documents/paymentAttempts/$(incoming().lastAttemptRef)).data.status == 'SUCCEEDED' &&
                getAfter(/databases/$(database)/documents/paymentAttempts/$(incoming().lastAttemptRef)).data.amount == existing().totalAmount) ||
              // Action B: Simulated Demo Payment FAILED / CANCELLED / EXPIRED / RETRY
              (incoming().status == 'PENDING_PAYMENT' &&
                incoming().stockDeducted == false &&
                (incoming().paymentStatus == 'FAILED' ||
                 incoming().paymentStatus == 'CANCELLED' ||
                 incoming().paymentStatus == 'EXPIRED' ||
                 incoming().paymentStatus == 'PENDING'))
            ))
        );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Payment Attempts Collection (Terminal-state locked; explicitly flagged as simulated demo)
    match /paymentAttempts/{attemptRef} {
      allow get: if isSignedIn() && isValidId(attemptRef) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(attemptRef) &&
        isValidPaymentAttempt(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'PENDING' &&
        incoming().isSimulatedDemo == true;
      allow update: if isVerified() && isValidId(attemptRef) && isValidPaymentAttempt(incoming()) &&
        existing().status == 'PENDING' &&
        incoming().id == existing().id &&
        incoming().attemptRef == existing().attemptRef &&
        incoming().orderId == existing().orderId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().userId == existing().userId &&
        incoming().amount == existing().amount &&
        incoming().createdAt == existing().createdAt &&
        incoming().expiresAt == existing().expiresAt &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'failureReason', 'updatedAt', 'completedAt']);
      allow delete: if false;
    }

    // Order Status History Collection (Append-only audit log tied to owned order; customers restricted to PENDING_PAYMENT / PAID)
    match /orderStatusHistory/{historyId} {
      allow get: if isSignedIn() && isValidId(historyId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(historyId) &&
        isValidOrderStatusHistory(incoming()) && (
          isAdmin() ||
          (incoming().userId == request.auth.uid &&
            (incoming().status == 'PENDING_PAYMENT' || incoming().status == 'PAID') &&
            getAfter(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid)
        );
      allow update, delete: if false;
    }

    // Public Masked Order Tracking Collection (Single-doc get only by orderNumber_mobile; list forbidden)
    match /orderTracking/{trackingKey} {
      allow get: if isValidId(trackingKey);
      allow list: if false;
      allow create: if isVerified() && isValidId(trackingKey) &&
        isValidOrderTrackingSummary(incoming()) &&
        incoming().userId == request.auth.uid;
      allow update: if isVerified() && isValidId(trackingKey) &&
        isValidOrderTrackingSummary(incoming()) &&
        incoming().trackingKey == existing().trackingKey &&
        incoming().orderNumber == existing().orderNumber &&
        (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() && isValidId(trackingKey);
    }

    // Inventory Movements Audit Collection (Admin read; Append-only write with math & reason enforcement)
    match /inventoryMovements/{movementId} {
      allow get: if isAdmin() && isValidId(movementId);
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(movementId) &&
        isValidInventoryMovement(incoming()) &&
        incoming().newStock == incoming().previousStock + incoming().delta && (
          isAdmin() ||
          (incoming().delta < 0 &&
            (incoming().reason == 'ORDER_PAID' || incoming().reason == 'BUNDLE_COMPONENT_PAID'))
        );
      allow update, delete: if false;
    }

    // Product Reviews Collection
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if resource.data.rating >= 1;
      allow create: if isVerified() && isValidId(reviewId) &&
        isValidProductReview(incoming()) &&
        incoming().userId == request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));
      allow update: if isVerified() && isValidId(reviewId) && isValidProductReview(incoming()) &&
        incoming().productId == existing().productId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment']))
        );
      allow delete: if isVerified() && isValidId(reviewId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Newsletter Subscriptions Collection (Create-only by visitors; Admin read)
    match /newsletterSubscriptions/{subId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(subId) &&
        isValidNewsletterSubscription(incoming()) &&
        !exists(/databases/$(database)/documents/newsletterSubscriptions/$(subId));
      allow update, delete: if isAdmin() && isValidId(subId);
    }
  }
}
